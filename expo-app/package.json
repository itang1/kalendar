{
  "name": "kalendar",
  "private": true,
  "version": "1.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --clear",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "rm -rf ../docs/app && EXPO_BASE_URL=/kalendar/app expo export --platform web --output-dir ../docs/app",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
